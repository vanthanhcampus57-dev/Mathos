# Mathos Local Development Environment Configuration
# API Service Config
ENVIRONMENT=development
LOG_LEVEL=info
API_V1_STR=/api/v1
PROJECT_NAME="Mathos Auth & Database Engine"
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Security Configuration
SECRET_KEY=local_dev_secret_key_change_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=mathos-db
POSTGRES_PORT=5432
POSTGRES_USER=mathos_dev
POSTGRES_PASSWORD=mathos_dev_password
POSTGRES_DB=mathos_local_db

# Local SMTP Configuration (Mailpit)
SMTP_HOST=mathos-mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@mathos.local

# Google OAuth Placeholder (Optional - defaults to NOT_CONFIGURED if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
